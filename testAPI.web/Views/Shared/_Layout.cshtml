<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - تجربة API</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/testAPI.web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-topbar sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    🛒 تجربة
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-1">
                        @if (User.Identity?.IsAuthenticated != true || User.HasClaim(c => c.Type == "ViewHome") || User.IsInRole("superadmin") || User.IsInRole("admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door"></i> الرئيسية
                                </a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.HasClaim(c => c.Type == "ViewRoles") || User.IsInRole("superadmin") || User.IsInRole("admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Roles" asp-action="Index">
                                        <i class="bi bi-shield-lock"></i> إدارة الأدوار
                                    </a>
                                </li>
                            }
                            @if (User.HasClaim(c => c.Type == "ViewUsers") || User.IsInRole("superadmin") || User.IsInRole("admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people"></i> إدارة المستخدمين
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="user-badge">
                                    <i class="bi bi-person-circle"></i>
                                    @(User.Identity.Name ?? "المستخدم")
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius: 8px;">
                                        <i class="bi bi-box-arrow-right"></i> خروج
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" style="border-radius: 8px;" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-left"></i> دخول
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" style="border-radius: 8px;" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> إنشاء حساب
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-container">
     
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        &copy; 2026 - تجربة - جميع الحقوق محفوظة
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
