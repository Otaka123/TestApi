@{
    ViewData["Title"] = "غير مصرح";
}

<div dir="rtl">
    <div class="row justify-content-center py-5">
        <div class="col-md-7 col-lg-6">
            <div class="app-card text-center py-5">
                <div class="mb-3">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background: var(--danger-soft); color: var(--danger); display: inline-flex; align-items: center; justify-content: center; font-size: 2rem;">
                        <i class="bi bi-slash-circle"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-danger mb-2">غير مصرح بالدخول</h2>
                <p class="text-muted mb-4">عذراً، ليس لديك الصلاحيات اللازمة للوصول إلى هذه الصفحة.</p>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house"></i> الصفحة الرئيسية
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary" style="border-radius: 8px;">
                        <i class="bi bi-arrow-right"></i> العودة للخلف
                    </button>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <small class="text-muted">رمز الخطأ: 403 - Forbidden</small>
                </div>
            </div>
        </div>
    </div>
</div>
