@model testAPI.api.domain.DTOs.Auth.RegisterRequestDto
@{
    ViewData["Title"] = "إنشاء حساب جديد";
}

<div dir="rtl">
    <div class="row justify-content-center py-5">
        <div class="col-md-7 col-lg-6">
            <div class="auth-card">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="auth-icon" style="background: var(--ok);">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <h3 class="fw-bold">إنشاء حساب جديد</h3>
                        <p class="text-muted small">أدخل البيانات التالية لإنشاء حساب جديد</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="floatingFullName" class="form-label">الاسم الكامل</label>
                                <input asp-for="FullName" class="form-control" id="floatingFullName" placeholder="الاسم الكامل" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="floatingUsername" class="form-label">اسم المستخدم</label>
                                <input asp-for="Username" class="form-control" id="floatingUsername" placeholder="اسم المستخدم" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="floatingEmail" class="form-label">البريد الإلكتروني</label>
                                <input asp-for="Email" type="email" class="form-control" id="floatingEmail" placeholder="البريد الإلكتروني" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="floatingPhone" class="form-label">رقم الهاتف</label>
                                <input asp-for="PhoneNumber" class="form-control" id="floatingPhone" placeholder="رقم الهاتف" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="floatingPassword" class="form-label">كلمة المرور</label>
                                <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="كلمة المرور" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="floatingConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" id="floatingConfirmPassword" placeholder="تأكيد كلمة المرور" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <input type="hidden" asp-for="RoleId" value="0" />
                        <input type="hidden" asp-for="UserTypeId" value="1" />

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3" style="background: var(--ok); border-color: var(--ok);">
                            <i class="bi bi-check-circle"></i> إنشاء الحساب
                        </button>

                        <div class="text-center">
                            <span class="text-muted">لديك حساب بالفعل؟</span>
                            <a asp-action="Login" class="fw-bold ms-1">تسجيل الدخول</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
