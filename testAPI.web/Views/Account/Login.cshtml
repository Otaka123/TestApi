@model testAPI.api.domain.DTOs.Auth.LoginRequestDto
@{
    ViewData["Title"] = "تسجيل الدخول";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div dir="rtl">
    <div class="row justify-content-center py-5">
        <div class="col-md-5 col-lg-4">
            <div class="auth-card">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="auth-icon">
                            <i class="bi bi-person-lock"></i>
                        </div>
                        <h3 class="fw-bold">تسجيل الدخول</h3>
                        <p class="text-muted small">قم بإدخال بياناتك للدخول إلى حسابك</p>
                    </div>

                

                    <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label for="floatingUsername" class="form-label">اسم المستخدم</label>
                            <input asp-for="Username" class="form-control" id="floatingUsername" placeholder="اسم المستخدم" autocomplete="username" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label for="floatingPassword" class="form-label">كلمة المرور</label>
                            <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="كلمة المرور" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                            <label class="form-check-label text-muted" for="rememberMeCheck">
                                تذكرني على هذا الجهاز
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3">
                            <i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول
                        </button>

                        <div class="text-center">
                            <span class="text-muted">ليس لديك حساب؟</span>
                            <a asp-action="Register" class="fw-bold ms-1">إنشاء حساب جديد</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
