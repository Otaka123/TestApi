@model testAPI.api.domain.DTOs.User.EditUserDto
@{
    ViewData["Title"] = "تعديل المستخدم";
}

<div dir="rtl">
    <div class="page-header">
        <h2><i class="bi bi-pencil-square"></i> تعديل بيانات المستخدم</h2>
    </div>

    <div class="app-card">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label">اسم المستخدم</label>
                    <input asp-for="UserName" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="RoleId" class="form-label">الدور (Role)</label>
                    <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select">
                        <option value="">-- اختر الدور --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="UserTypeId" class="form-label">نوع المستخدم</label>
                    <select asp-for="UserTypeId" class="form-select">
                        <option value="1" selected="@(Model.UserTypeId == 1)">مستخدم عادي</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> تحديث البيانات
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;">
                    <i class="bi bi-arrow-right"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
</div>
