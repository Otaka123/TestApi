@model testAPI.api.domain.DTOs.Role.CreateRoleDTO
@{
    ViewData["Title"] = "إنشاء دور جديد";
}

<div dir="rtl">
    <div class="page-header">
        <h2><i class="bi bi-plus-circle"></i> إنشاء دور جديد</h2>
    </div>

    <div class="app-card" style="max-width: 600px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">اسم الدور</label>
                <input asp-for="Name" class="form-control" placeholder="أدخل اسم الدور" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> حفظ
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;">
                    <i class="bi bi-arrow-right"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
</div>
