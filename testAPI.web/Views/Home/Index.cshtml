@{
    ViewData["Title"] = "الرئيسية";
}

<div dir="rtl" class="py-4">
    <div class="app-card text-center py-5">
        <div class="mb-3">
            <span style="font-size: 3.5rem;">🛒</span>
        </div>
        <p class="text-muted lead mx-auto" style="max-width: 600px;">
            نظام إدارة المستخدمين والصلاحيات والأدوار مبني بأحدث التقنيات التقنية ليوفر تجربة سلسة وآمنة.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-controller="Users" asp-action="Index" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-people"></i> إدارة المستخدمين
                </a>
                <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-primary px-4 py-2" style="border-radius: 8px;">
                    <i class="bi bi-shield-lock"></i> إدارة الأدوار
                </a>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary px-4 py-2" style="border-radius: 8px;">
                    <i class="bi bi-person-plus"></i> إنشاء حساب جديد
                </a>
            </div>
        }
    </div>
</div>
